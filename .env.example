# Salin jadi .env lalu isi. JANGAN commit file .env.

# ---------- Provider AI ----------
# Isi minimal satu key. Semua kosong = mode demo (jawaban contoh, gratis).
# Provider dicoba sesuai LLM_ORDER; kalau satu gagal (kuota habis, server sibuk, key salah)
# sebelum sempat menjawab, otomatis pindah ke provider berikutnya. Yang tanpa key dilewati.
LLM_ORDER=gemini,groq,openrouter,claude

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_LEADER=gemini-3.5-flash
GEMINI_MODEL_TEAM=gemini-2.5-flash

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL_LEADER=openai/gpt-oss-120b
GROQ_MODEL_TEAM=openai/gpt-oss-20b

# OpenRouter (https://openrouter.ai/keys). Model berakhiran :free gratis tapi sering antre.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_LEADER=google/gemma-4-31b-it:free
OPENROUTER_MODEL_TEAM=google/gemma-4-26b-a4b-it:free

# Claude / Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
MODEL_LEADER=claude-sonnet-5-5
MODEL_TEAM=claude-haiku-4-5-20251001

# ---------- Server ----------
# Kode yang harus dimasukkan pengunjung sebelum bisa chat. WAJIB diisi kalau situs publik.
ACCESS_CODE=

PORT=3001

# Pengaman biaya
MAX_TOKENS=1500
RATE_PER_MINUTE=15
DAILY_MAX_REQUESTS=300
